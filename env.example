# Copy to back_end/.env. One service handles BOTH sites. Never commit secrets.
AUTH_DEV_UPSTREAM_BASE_URL=https://futuredev.artz.zone/api
AUTH_PROD_UPSTREAM_BASE_URL=https://future.artz.zone/api
AUTH_UPSTREAM_ME_PATH=/auth/me
ARK_API_KEY=
DEEPSEEK_API_KEY=
# Optional key for a different OpenAI-compatible provider selected in admin.
LLM_API_KEY=
# Generate once: openssl rand -base64 32. Keep and back up the same value.
ENCRYPTION_MASTER_KEY=

# Host loopback port only. Check it is free before the first start.
KB_PORT=8080
COMPOSE_PROJECT_NAME=course-knowledge
# Optional Python executable for PDF/DOCX/PPTX extraction; Windows preview detects it.
# KB_PYTHON_BIN=C:/path/to/python.exe
# PDF/PPTX pages are indexed as matching text + rendered images, including scans.
# Docker includes pypdf, Poppler, Node.js, PPTX libraries and Chinese fonts.
# PPTX is parsed/rendered by code; no Office/LibreOffice installation is needed.
# Local setup once: npm ci --prefix processing (Node >=22.18).
# Also: py -3 -m pip install -r processing/requirements.txt (Linux: python3 -m pip).
# KB_NODE_BIN=C:/path/to/node.exe
# KB_PPTX_PROCESSOR=C:/path/to/back_end/processing/pptx.mjs
# Directory containing pdfinfo and pdftoppm (optional if both on PATH).
# KB_POPPLER_BIN_DIR=C:/path/to/poppler/Library/bin
# Optional per-tool overrides if the Windows utilities are in separate folders.
# KB_PDFINFO_BIN=C:/path/to/pdfinfo.exe
# KB_PDFTOPPM_BIN=C:/path/to/pdftoppm.exe
KB_DOCUMENT_MAX_PAGES=200
# Optional native Qdrant binary for automatic local cargo run startup.
# KB_QDRANT_BIN=C:/path/to/qdrant.exe
# Relative paths resolve from back_end/. Use an absolute, stable path on a server,
# e.g. /srv/course-knowledge-data; keep it unchanged when replacing code.
# Existing deployments must keep their ORIGINAL data directories and migrate
# any legacy SQLite explicitly before selecting the new dev/prod DB paths.
KB_HOST_DATA_DIR=./data
# Stable tag for building elsewhere and transferring with docker save/load.
KB_SERVICE_IMAGE=3dcourse-knowledge-service:local

# Durable resource storage. Keep the bucket private; the Rust service signs
# requests and the browser continues to use its short-lived media tickets.
# localhost/127.0.0.1/futuredev use dev; future.artz.zone uses prod.
# Storage is OSS-only. Files on disk are disposable extraction/model caches.
KB_STORAGE_BACKEND=oss
# Existing courseware sources, isolated by site. Exact HTTPS hostnames only.
KB_DEV_COURSEWARE_HOSTS=futuredev-cdn.artz.zone,futuredev.oss-cn-beijing.aliyuncs.com
KB_PROD_COURSEWARE_HOSTS=future-cdn.artz.zone,futureprod.oss-cn-beijing.aliyuncs.com
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_DEV_BUCKET=futuredev
OSS_PROD_BUCKET=futureprod
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Object paths are fixed: knowledge/doc/ and knowledge/user_upload/ (30 days).
# Optional Docker database overrides (container paths, not Windows host paths):
# KB_DEV_DATABASE_URL=sqlite:///var/lib/knowledge-service/data/dev/knowledge.sqlite?mode=rwc
# KB_PROD_DATABASE_URL=sqlite:///var/lib/knowledge-service/data/prod/knowledge.sqlite?mode=rwc

# Small-scale trial defaults; tune using actual usage and host headroom.
KB_SERVICE_CPUS=0.5
KB_SERVICE_MEMORY=768m
KB_QDRANT_CPUS=0.5
KB_QDRANT_MEMORY=768m

ARK_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
ARK_EMBEDDING_MODEL=doubao-embedding-vision-251215
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_PROTOCOL=chat
LLM_THINKING=enabled
LLM_REASONING_EFFORT=high
LLM_VISION_ENABLED=true
KB_MODEL_ALLOWED_HOSTS=ark.cn-beijing.volces.com,cn.bestpudding.xyz,api.deepseek.com
KB_MIN_VECTOR_SCORE=0.25
